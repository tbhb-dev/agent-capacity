<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.tbhb.agent-capacity.serve.claude-claude-primary</string>
	<key>UserName</key>
	<string>capacity</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/agent-capacity</string>
		<string>serve</string>
		<string>--spool-dir=/Users/capacity/spool-claude-primary</string>
		<string>--claude-transcripts=/Users/capacity/accounts/claude-claude-primary/config/projects</string>
		<string>--claude-account=claude-primary</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_CAPACITY_SPOOL_DIR</key>
		<string>/Users/capacity/spool</string>
		<key>OTEL_EXPORTER_OTLP_PROTOCOL</key>
		<string>http/protobuf</string>
		<key>OTEL_METRIC_EXPORT_INTERVAL</key>
		<string>15000</string>
		<key>OTEL_RESOURCE_ATTRIBUTES</key>
		<string>host.name=usdhosv06</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/agent-capacity-serve-claude-primary.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/agent-capacity-serve-claude-primary.log</string>
</dict>
</plist>
