{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#ee8796e773fd7b5962f71f2fbd0a16391de33b0f", // main
    "github>tbhb-dev/renovate-config//bazel.json5#ee8796e773fd7b5962f71f2fbd0a16391de33b0f", // main
    "github>tbhb-dev/renovate-config//go.json5#ee8796e773fd7b5962f71f2fbd0a16391de33b0f", // main
    "github>tbhb-dev/renovate-config//python.json5#ee8796e773fd7b5962f71f2fbd0a16391de33b0f", // main
  ],

  // The Go module, Bazel pins and uv lock are covered by the presets. The one
  // addition is a rule that stops Renovate from changing the go and toolchain
  // directives in go.mod: the module declares go 1.26 on purpose, and the
  // toolchain directive sets the Go release Bazel's go_sdk uses, so a person
  // changes either one.
  packageRules: [
    {
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      enabled: false,
    },
  ],
}
