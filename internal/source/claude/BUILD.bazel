load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "claude",
    srcs = ["claude.go"],
    importpath = "go.tbhb.dev/agent-capacity/internal/source/claude",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/capacity",
        "//internal/spool",
    ],
)

go_test(
    name = "claude_test",
    srcs = ["claude_test.go"],
    embed = [":claude"],
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/capacity",
        "//internal/spool",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
