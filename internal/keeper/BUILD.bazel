load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

exports_files(
    ["testdata/stops.json"],
    visibility = ["//:__pkg__"],
)

go_library(
    name = "keeper",
    srcs = [
        "decision.go",
        "keeper.go",
        "store.go",
    ],
    importpath = "go.tbhb.dev/agent-capacity/internal/keeper",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "keeper_test",
    srcs = [
        "decision_test.go",
        "keeper_test.go",
        "store_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":keeper"],
    visibility = ["//:__pkg__"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
