load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

exports_files(
    ["testdata/stops.json"],
    visibility = ["//:__pkg__"],
)

go_library(
    name = "keepalive",
    srcs = [
        "decision.go",
        "keepalive.go",
        "store.go",
    ],
    importpath = "go.tbhb.dev/agent-capacity/internal/keepalive",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "keepalive_test",
    srcs = [
        "decision_test.go",
        "keepalive_test.go",
        "store_test.go",
        "store_unix_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":keepalive"],
    visibility = ["//:__pkg__"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
